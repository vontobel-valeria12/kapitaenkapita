<!DOCTYPE html>
<html lang="de">

<head>

  <!-- =====================================================
       1. META-DATEN
  ====================================================== -->

  <meta charset="UTF-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  >

  <meta
    name="description"
    content="Kapitänin Kapita – Die Olympischen Spiele. Ein interaktives Kinderbuch."
  >

  <title>Kapitänin Kapita – Die Olympischen Spiele</title>


  <!-- =====================================================
       2. STYLESHEET
  ====================================================== -->

  <link
    rel="stylesheet"
    href="flipbuch2.css"
  >


  <!-- =====================================================
       3. PAGE-FLIP-BIBLIOTHEK
  ====================================================== -->

  <script
    src="https://cdn.jsdelivr.net/npm/page-flip/dist/js/page-flip.browser.min.js"
  ></script>

</head>


<body data-book-id="olympische-spiele">


  <!-- =====================================================
       4. HINTERGRUND
  ====================================================== -->

  <div
    class="stars"
    aria-hidden="true"
  ></div>


  <!-- =====================================================
       5. HAUPTBEREICH DES BUCHES
  ====================================================== -->

  <main class="book-area">


    <!-- ===================================================
         5.1 BUCHKOPF
    ==================================================== -->

    <header class="book-header">

      <h1>
        Kapitänin Kapita
      </h1>

      <p>
        Die Olympischen Spiele
      </p>

    </header>


    <!-- ===================================================
         5.2 BUCHCONTAINER
    ==================================================== -->

    <div class="book-container">


      <!-- =================================================
           5.2.1 FLIPBOOK
      ================================================== -->

      <div id="flipbook">


        <!-- =================================================
             SEITE 0
             TITELSEITE
        ================================================== -->

        <div class="page cover">

          <div class="page-content">

            <div class="reading-text">

              <div class="book-text">

                <h1>
                  Kapitänin Kapita
                </h1>

                <h2>
                  Die Olympischen Spiele
                </h2>

              </div>

            </div>

          </div>

        </div>


        <!-- =================================================
             SEITE 1
             KAPITEL 1 – DIE RÜCKKEHR
             GROSSE ILLUSTRATION
        ================================================== -->

        <div class="page image-page chapter-opening-page">

          <div class="page-content">

            <figure class="book-illustration book-illustration-large">

              <img
                src="img/kapitel1-erde.png"
                alt="Kapitänin Kapita sieht nach einer langen Reise die Erde wieder."
                loading="eager"
              >

            </figure>

            <div class="chapter-image-title">

              <h2>
                Kapitel 1 – Die Rückkehr
              </h2>

            </div>

          </div>

        </div>


        <!-- =================================================
             SEITE 2
             KAPITEL 1 – DIE RÜCKKEHR
             ANKUNFT AN DER ERDE
        ================================================== -->

        <div class="page reading-page">

          <div class="page-content">

            <div class="reading-text">


              <!-- Kleine Kapitelillustration -->

              <figure class="book-illustration book-illustration-small">

                <img
                  src="img/kapitel1-erde-detail.png"
                  alt="Die Erde wird vor Kapitas Raumschiff langsam größer."
                  loading="lazy"
                >

              </figure>


              <!-- Lesetext -->

              <div class="book-text auto-scroll">

                <p>
                  Nach einer langen Reise durch das Sonnensystem
                  war Kapitänin Kapita endlich auf dem Weg nach Hause.
                </p>

                <p>
                  Vor ihr lag unsere geliebte Erde:
                  ein kleiner blauer Planet, der für Kapita
                  noch immer der schönste und außergewöhnlichste Ort
                  im ganzen Universum war.
                </p>

                <p>
                  Sie konnte es kaum erwarten,
                  wieder in die Erdatmosphäre einzutreten.
                </p>

              </div>

            </div>

          </div>

        </div>


        <!-- =================================================
             SEITE 3
             KAPITEL 1 – DIE RÜCKKEHR
             HEIMWEH
        ================================================== -->

        <div class="page reading-page">

          <div class="page-content">

            <div class="reading-text">


              <!-- Kleine Kapitelillustration -->

              <figure class="book-illustration book-illustration-small">

                <img
                  src="img/kapitel1-erde-detail.png"
                  alt="Kapitänin Kapita nähert sich der Erde."
                  loading="lazy"
                >

              </figure>


              <!-- Lesetext -->

              <div class="book-text auto-scroll">

                <p>
                  Nach so langer Zeit im Weltraum vermisste sie Dinge,
                  die ihr früher ganz selbstverständlich erschienen waren.
                </p>

                <p>
                  Sie vermisste ihre Familie,
                  ihre Freunde und all das,
                  was für sie bedeutete,
                  zu Hause zu sein.
                </p>

                <p>
                  Doch noch musste sie sich
                  ein wenig gedulden.
                </p>

              </div>

            </div>

          </div>

        </div>


        <!-- =================================================
             SEITE 4
             KAPITEL 1 – DIE RÜCKKEHR
             SICHERHEIT VOR DER LANDUNG
        ================================================== -->

        <div class="page reading-page">

          <div class="page-content">

            <div class="reading-text">

              <div class="book-text auto-scroll">

                <p>
                  Bevor sie mit der Landung beginnen konnte,
                  mussten alle Systeme des Raumschiffs
                  überprüft werden.
                </p>

                <p>
                  Kapita kannte die Regeln genau:
                  Es spielte keine Rolle,
                  wie müde sie war
                  oder wie sehr sie sich danach sehnte,
                  endlich anzukommen.
                </p>

                <p>
                  Eine Weltraumreise war erst dann beendet,
                  wenn das Raumschiff sicher gelandet war.
                </p>

                <p>
                  Und diese Reise war lang
                  und anstrengend gewesen.
                </p>

              </div>

            </div>

          </div>

        </div>


        <!-- =================================================
             SEITE 5
             KAPITEL 1 – DIE RÜCKKEHR
             VERÄNDERT ZURÜCK
        ================================================== -->

        <div class="page reading-page">

          <div class="page-content">

            <div class="reading-text">

              <div class="book-text auto-scroll">

                <p>
                  Doch Kapita kehrte nicht ganz als dieselbe zurück,
                  die einst aufgebrochen war.
                </p>

                <p>
                  Während ihrer Reise durch das Sonnensystem
                  hatte sie außergewöhnliche Orte kennengelernt.
                </p>

                <p>
                  Sie hatte Dinge gelernt,
                  die sie sich früher niemals
                  hätte vorstellen können.
                </p>

                <p>
                  Und sie hatte unglaubliche Freundschaften geschlossen,
                  die sie niemals vergessen würde.
                </p>

              </div>

            </div>

          </div>

        </div>


        <!-- =================================================
             SEITE 6
             KAPITEL 1 – DIE RÜCKKEHR
             DIE ERDE VOR AUGEN
        ================================================== -->

        <div class="page reading-page">

          <div class="page-content">

            <div class="reading-text">

              <div class="book-text auto-scroll">

                <p>
                  Nun war sie endlich wieder da.
                </p>

                <p>
                  Kapita stand vor dem Fenster ihrer Kabine
                  und beobachtete,
                  wie die Erde vor ihren Augen
                  langsam größer wurde.
                </p>

                <p>
                  Blau.
                </p>

                <p>
                  Wunderschön.
                </p>

                <p>
                  Ihr Zuhause.
                </p>

                <p>
                  Sie lächelte
                  und blieb einen Moment lang
                  einfach dort stehen.
                </p>

              </div>

            </div>

          </div>

        </div>


        <!-- =================================================
             SEITE 7
             KAPITEL 1 – DIE RÜCKKEHR
             DAS SELTSAME GEFÜHL
        ================================================== -->

        <div class="page reading-page">

          <div class="page-content">

            <div class="reading-text">

              <div class="book-text auto-scroll">

                <p>
                  Ihr Blick blieb fest
                  auf den Planeten gerichtet.
                </p>

                <p>
                  Doch langsam verschwand ihr Lächeln.
                </p>

                <p>
                  Irgendetwas war seltsam.
                </p>

                <p>
                  Kapita beobachtete die Erde weiter.
                </p>

                <p>
                  Alles wirkte ...
                </p>

                <p>
                  <strong>
                    viel zu still.
                  </strong>
                </p>

              </div>

            </div>

          </div>

        </div>


        <!-- =================================================
             SEITE 8
             KAPITEL 1 – DIE RÜCKKEHR
             SCHLUSS
        ================================================== -->

        <div class="page reading-page">

          <div class="page-content">

            <div class="reading-text">

              <div class="book-text auto-scroll">

                <p>
                  Kapita wusste ganz genau:
                </p>

                <p>
                  Manchmal,
                  wenn alles viel zu still erscheint ...
                </p>

                <p>
                  <strong>
                    ist das kein gutes Zeichen.
                  </strong>
                </p>

              </div>

            </div>

          </div>

        </div>


        <!-- =================================================
             SEITE 9
             KAPITEL 2 – DIE ENTDECKUNG DES PROBLEMS
             ALARMSIGNAL
        ================================================== -->

        <div class="page reading-page">

          <div class="page-content">

            <div class="reading-text">

              <div class="book-text auto-scroll">

                <h2>
                  Kapitel 2 – Die Entdeckung des Problems
                </h2>

                <p>
                  Im Kontrollzentrum der Raumstation
                  schlugen plötzlich die Sensoren Alarm.
                </p>

                <p>
                  Zoe empfing ein Warnsignal von der Erde.
                </p>

                <p>
                  Irgendetwas war aus dem Gleichgewicht geraten.
                </p>

                <p>
                  Sie überprüfte die Daten noch einmal,
                  doch das Signal blieb bestehen.
                </p>

              </div>

            </div>

          </div>

        </div>


        <!-- =================================================
             SEITE 10
             KAPITEL 2 – DIE ENTDECKUNG DES PROBLEMS
             ZOE RUFT KAPITA
        ================================================== -->

        <div class="page reading-page">

          <div class="page-content">

            <div class="reading-text">

              <div class="book-text auto-scroll">

                <p>
                  Kapita musste zurückkommen.
                </p>

                <p>
                  Zoe rief sie sofort.
                </p>

                <p>
                  Kapita meldete sich kurze Zeit später.
                </p>

                <p>
                  Zoe, was ist los?
                </p>

                <p>
                  Zoe antwortete sofort.
                </p>

                <p>
                  Ich empfange ein Gefahrensignal von der Erde.
                </p>

                <p>
                  Irgendetwas stimmt nicht.
                  Wir müssen herausfinden,
                  was passiert.
                </p>

              </div>

            </div>

          </div>

        </div>


        <!-- =================================================
             SEITE 11
             KAPITEL 2 – DIE ENTDECKUNG DES PROBLEMS
             KAPITA KEHRT ZURÜCK
        ================================================== -->

        <div class="page reading-page">

          <div class="page-content">

            <div class="reading-text">

              <div class="book-text auto-scroll">

                <p>
                  Kapita zögerte nicht lange.
                </p>

                <p>
                  Sie verabschiedete sich
                  von ihrer Familie und ihren Freunden.
                </p>

                <p>
                  Sofort machte sie sich
                  auf den Weg zurück zum Raumschiff.
                </p>

                <p>
                  Alles ging so schnell,
                  dass es ihr beinahe vorkam,
                  als wäre sie gar nicht richtig
                  zu Hause gewesen.
                </p>

              </div>

            </div>

          </div>

        </div>


        <!-- =================================================
             SEITE 12
             KAPITEL 2 – DIE ENTDECKUNG DES PROBLEMS
             UNRUHE AUF DEM RÜCKWEG
        ================================================== -->

        <div class="page reading-page">

          <div class="page-content">

            <div class="reading-text">

              <div class="book-text auto-scroll">

                <p>
                  Unterwegs musste sie immer wieder
                  an Zoes Worte denken.
                </p>

                <p>
                  <strong>
                    Ein Gefahrensignal.
                  </strong>
                </p>

                <p>
                  Was konnte so dringend sein?
                </p>

                <p>
                  Ein ungutes Gefühl
                  machte sich in ihr breit.
                </p>

                <p>
                  Was, wenn wirklich
                  etwas Schlimmes passiert war?
                </p>

              </div>

            </div>

          </div>

        </div>


        <!-- =================================================
             SEITE 13
             KAPITEL 2 – ILLUSTRATION
        ================================================== -->

        <div class="page image-page">

          <div class="page-content">

            <figure class="book-illustration book-illustration-large">

              <img
                src="img/kapitel2-kontrollzentrum.png"
                alt="Kapitänin Kapita und Zoe untersuchen ungewöhnliche Daten von der Erde im Kontrollzentrum."
                loading="lazy"
              >

            </figure>

          </div>

        </div>


        <!-- =================================================
             SEITE 14
             KAPITEL 2 – DIE ENTDECKUNG DES PROBLEMS
             IM KONTROLLZENTRUM
        ================================================== -->

        <div class="page reading-page">

          <div class="page-content">

            <div class="reading-text">

              <div class="book-text auto-scroll">

                <p>
                  Kurze Zeit später
                  war Kapita wieder an Bord.
                </p>

                <p>
                  Sie ging direkt
                  ins Kontrollzentrum.
                </p>

                <p>
                  Zoe, was ist passiert?
                </p>

                <p>
                  Kapitas Stimme klang besorgt.
                </p>

                <p>
                  Zoe blickte auf die Bildschirme.
                </p>

                <p>
                  Genau das versuche ich herauszufinden.
                </p>

              </div>

            </div>

          </div>

        </div>


        <!-- =================================================
             SEITE 15
             KAPITEL 2 – DIE ENTDECKUNG DES PROBLEMS
             DIE DATEN
        ================================================== -->

        <div class="page reading-page">

          <div class="page-content">

            <div class="reading-text">

              <div class="book-text auto-scroll">

                <p>
                  Auf den großen Bildschirmen
                  erschienen verschiedene Daten
                  von der Erde.
                </p>

                <p>
                  Einige Werte
                  waren ungewöhnlich niedrig.
                </p>

                <p>
                  Die Linien in den Grafiken
                  sanken immer weiter.
                </p>

                <p>
                  Kapita trat näher
                  an die Bildschirme.
                </p>

                <p>
                  Was bedeutet das?
                </p>

              </div>

            </div>

          </div>

        </div>


        <!-- =================================================
             SEITE 16
             KAPITEL 2 – DIE ENTDECKUNG DES PROBLEMS
             DAS RÄTSEL
        ================================================== -->

        <div class="page reading-page">

          <div class="page-content">

            <div class="reading-text">

              <div class="book-text auto-scroll">

                <p>
                  Zoe antwortete nicht sofort.
                </p>

                <p>
                  Sie prüfte die Daten erneut.
                </p>

                <p>
                  Das ist das Seltsame.
                </p>

                <p>
                  Kapita runzelte die Stirn.
                </p>

                <p>
                  Was meinst du?
                </p>

                <p>
                  Zoe zeigte auf die fallenden Linien.
                </p>

                <p>
                  Ich kann sehen,
                  dass sich etwas verändert hat.
                </p>

                <p>
                  Aber ich kann noch nicht erkennen,
                  warum.
                </p>

              </div>

            </div>

          </div>

        </div>


        <!-- =================================================
             SEITE 17
             KAPITEL 2 – DIE ENTDECKUNG DES PROBLEMS
             SCHLUSS
        ================================================== -->

        <div class="page reading-page">

          <div class="page-content">

            <div class="reading-text">

              <div class="book-text auto-scroll">

                <p>
                  Kapita betrachtete
                  die fallenden Linien.
                </p>

                <p>
                  Dann müssen wir es herausfinden.
                </p>

                <p>
                  Zoe nickte.
                </p>

                <p>
                  Auf den Bildschirmen
                  blinkte das Warnsignal weiter.
                </p>

                <p>
                  Irgendetwas geschah
                  auf der Erde.
                </p>

                <p>
                  Doch was dahintersteckte,
                  wussten sie noch nicht.
                </p>

                <p>
                  <strong>
                    Noch nicht.
                  </strong>
                </p>

              </div>

            </div>

          </div>

        </div>


        <!-- =================================================
             SEITE 18
             PLATZHALTER – NÄCHSTES KAPITEL
        ================================================== -->

        <div class="page reading-page">

          <div class="page-content">

            <div class="reading-text">

              <div class="book-text auto-scroll">

                <h2>
                  Nächste Seite
                </h2>

                <p>
                  Der Text wird später eingefügt.
                </p>

              </div>

            </div>

          </div>

        </div>


        <!-- =================================================
             SEITE 19
             PLATZHALTER – NÄCHSTES KAPITEL
        ================================================== -->

        <div class="page reading-page">

          <div class="page-content">

            <div class="reading-text">

              <div class="book-text auto-scroll">

                <h2>
                  Nächste Seite
                </h2>

                <p>
                  Der Text wird später eingefügt.
                </p>

              </div>

            </div>

          </div>

        </div>


        <!-- =================================================
             LETZTE SEITE
        ================================================== -->

        <div class="page end-page">

          <div class="end-content">

            <h2>
              Fortsetzung folgt ...
            </h2>

            <p>
              Kapitas Abenteuer hat gerade erst begonnen.
            </p>

          </div>

        </div>


      </div>
      <!-- ENDE: FLIPBOOK -->


    </div>
    <!-- ENDE: BUCHCONTAINER -->


    <!-- ===================================================
         5.3 BUCHSTEUERUNG
    ==================================================== -->

    <nav
      class="book-controls"
      aria-label="Buchsteuerung"
    >


      <!-- =================================================
           5.3.1 AUDIO
      ================================================== -->

      <button
        id="audioButton"
        type="button"
      >
        🔊 Vorlesen
      </button>


      <!-- =================================================
           5.3.2 LESEMODUS
      ================================================== -->

      <button
        id="readingModeButton"
        type="button"
      >
        📖 Lesemodus
      </button>


      <!-- =================================================
           5.3.3 SEITENÜBERSICHT
      ================================================== -->

      <button
        id="pageMenuButton"
        type="button"
        aria-label="Seitenübersicht öffnen"
      >
        ▦ Seiten
      </button>


      <!-- =================================================
           5.3.4 SEITENNAVIGATION
      ================================================== -->

      <div class="page-navigation">

        <button
          id="prevPage"
          class="page-nav-btn"
          type="button"
          aria-label="Vorherige Seite"
        >
          ‹
        </button>


        <span
          id="pageCounter"
          aria-live="polite"
        >
          Seite 1
        </span>


        <button
          id="nextPage"
          class="page-nav-btn"
          type="button"
          aria-label="Nächste Seite"
        >
          ›
        </button>

      </div>


      <!-- =================================================
           5.3.5 VOLLBILD
      ================================================== -->

      <button
        id="fullscreenButton"
        type="button"
      >
        ⛶ Vollbild
      </button>


      <!-- =================================================
           5.3.6 BUCH BEENDEN
      ================================================== -->

      <button
        id="exitBookButton"
        type="button"
        data-exit-url="index.html"
      >
        ✕ Beenden
      </button>


    </nav>


  </main>


  <!-- =====================================================
       6. SEITENÜBERSICHT
  ====================================================== -->

  <div
    id="pageMenu"
    class="page-sidebar"
    aria-hidden="true"
  >


    <!-- ===================================================
         6.1 SEITENPANEL
    ==================================================== -->

    <aside
      class="page-sidebar-panel"
      role="dialog"
      aria-modal="true"
      aria-labelledby="pageMenuTitle"
    >


      <!-- =================================================
           6.1.1 PANELKOPF
      ================================================== -->

      <div class="page-sidebar-header">

        <h2 id="pageMenuTitle">
          Seiten
        </h2>


        <button
          id="closePageMenu"
          class="close-page-menu"
          type="button"
          aria-label="Seitenübersicht schließen"
        >
          ✕
        </button>

      </div>


      <!-- =================================================
           6.1.2 SEITENLISTE
           WIRD DURCH BOOK.JS ERZEUGT
      ================================================== -->

      <div
        id="pageList"
        class="page-thumbnail-list"
      ></div>


    </aside>


  </div>


  <!-- =====================================================
       7. JAVASCRIPT
  ====================================================== -->

  <script src="book.js"></script>


</body>

</html>